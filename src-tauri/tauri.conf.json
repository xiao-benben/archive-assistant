{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "归档助手",
  "version": "0.2.3",
  "identifier": "com.ben.archive-assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "归档助手",
        "width": 1380,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "本地优先的智能文件、收藏与计划管理工具",
    "longDescription": "归档助手安全管理 D:\\自动归档中的真实文件，提供收藏、计划、离线 OCR 与可扩展连接器。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
